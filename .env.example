# Fedora CoreOS Newsletter Generator Configuration

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=coreos
GITHUB_REPO=coreos-assembler,coreos-installer,ignition,afterburn,butane,bootupd

# LLM Provider - choose one: claude or gemini
LLM_PROVIDER=claude

# ============================================================================
# CLAUDE (Anthropic) - Set LLM_PROVIDER=claude
# ============================================================================
# Set ANTHROPIC_API_KEY in your environment:
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Or uncomment below (not recommended - put keys in environment instead):
# ANTHROPIC_API_KEY=sk-ant-...

CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================================================
# GEMINI (Google) - Set LLM_PROVIDER=gemini
# ============================================================================
# Set GOOGLE_API_KEY in your environment:
#   export GOOGLE_API_KEY=your_api_key...
#
# Or uncomment below (not recommended - put keys in environment instead):
# GOOGLE_API_KEY=your_api_key_here

GEMINI_MODEL=gemini-2.5-flash
